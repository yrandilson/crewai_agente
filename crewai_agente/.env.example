# ==============================================
# CONFIGURAÇÕES DO CREWAI AGENTE
# ==============================================

# Chave da OpenAI (obrigatório)
OPENAI_API_KEY=sk-...

# Modelo a ser usado (padrão: gpt-4o)
OPENAI_MODEL_NAME=gpt-4o

# Chave da Anthropic (opcional - para usar Claude como LLM)
# ANTHROPIC_API_KEY=sk-ant-...

# Configurações opcionais
VERBOSE=true
